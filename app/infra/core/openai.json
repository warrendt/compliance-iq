      "properties": {
        "model": {
          "format": "OpenAI",
          "name": "[parameters('fallbackModel')]",
          "version": "[parameters('fallbackVersion')]"
        },
        "versionUpgradeOption": "OnceNewDefaultVersionAvailable",
        "raiPolicyName": "Microsoft.Default"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts/deployments', parameters('name'), parameters('primaryDeploymentName'))]",
        "[resourceId('Microsoft.CognitiveServices/accounts', parameters('name'))]"
