    },
    "endpoint": {
      "type": "string",
      "value": "[if(parameters('existingAccount'), reference(resourceId('Microsoft.CognitiveServices/accounts', parameters('name')), '2023-05-01').endpoint, reference(resourceId('Microsoft.CognitiveServices/accounts', parameters('name')), '2023-05-01').endpoint)]"
    },
    "deploymentName": {
      "type": "string",
      "value": "[if(parameters('existingAccount'), parameters('primaryDeploymentName'), parameters('primaryDeploymentName'))]"
    },
    "fallbackDeploymentName": {
      "type": "string",
      "value": "[if(parameters('existingAccount'), parameters('fallbackDeploymentName'), if(and(not(equals(parameters('modelName'), parameters('fallbackModel'))), not(equals(parameters('primaryDeploymentName'), parameters('fallbackDeploymentName')))), parameters('fallbackDeploymentName'), ''))]"
    },
    "apiVersion": {
      "type": "string",
      "value": "[parameters('apiVersion')]"
    },
    "openAiUserRoleId": {
      "type": "string",
      "value": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('openAiUserRoleId'))]"
    }
  }
