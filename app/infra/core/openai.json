      ]
    },
    {
      "condition": "[and(and(not(parameters('existingAccount')), not(equals(parameters('modelName'), parameters('fallbackModel')))), not(equals(parameters('primaryDeploymentName'), parameters('fallbackDeploymentName'))))]",
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', parameters('name'), parameters('fallbackDeploymentName'))]",
      "sku": {
        "name": "[parameters('deploymentSku')]",
        "capacity": "[parameters('deploymentCapacity')]"
