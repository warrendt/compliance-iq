        "publicNetworkAccess": "[if(not(empty(parameters('devPublicIpAddress'))), 'Enabled', 'Disabled')]",
        "networkAcls": {
          "defaultAction": "Deny",
          "ipRules": "[if(not(empty(parameters('devPublicIpAddress'))), createArray(createObject('value', parameters('devPublicIpAddress'))), createArray())]",
          "virtualNetworkRules": []
